<% content_for(:title) { "Log in — Nebula" } %>

<% content_for(:head) do %>
<meta name="description" content="Log into Nebula.">
<style>
p.forgot {
  font-size: 0.86em;
  margin: 0 auto 1rem;
  text-align: left;
}
</style>
<% end %>

<div id="pricing" class="content-container wide-form">
  <div class="row">
    <div style="margin: 0 auto;">
      <h1>Log in</h1>

      <% if flash[:alert].present? %>
        <ul class="errors">
          <li class="urgent"><%= flash[:alert] %></li>
        </ul>
      <% end %>

      <div id="billing">
        <form action="/login" method="POST" id="login-form" onsubmit="return login()">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <dl class="billing">
            <label>
              <dt>Username</dt>
              <dd>
                <input type="text" id="username" name="username" style="width: 100%; box-sizing: border-box;" value="<%= params[:username] %>" tabindex="1" <%= 'autofocus' unless params[:username].present? %> />
              </dd>
            </label>
            <label>
              <dt>Password</dt>
              <dd><input type="password" name="password" id="password" autocomplete="current-password" placeholder="" tabindex="2" style="width: 100%; box-sizing: border-box;" <%= 'autofocus' if params[:username].present? %> /></dd>
            </label>
            <dt>
              <p class="forgot"><a href="/reset">Forgot password?</a></p>
              <button id="btn-login" type="submit" style="margin-top: 0.5em; padding: 0.5em 1.5em; background: var(--primary); color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 1em;">Log in</button>
            </dt>
          </dl>
        </form>
      </div>

      <p style="text-align: center; font-size: 0.9em; margin-top: 2em;">
        <em>No account yet?</em> <a href="/signup">Sign up</a> to start a blog.
      </p>
    </div>
  </div>

  <script type="text/javascript">
  function login() {
    var $user = document.getElementById('username');
    var $pass = document.getElementById('password');

    if ($user.value == "") {
      $user.className = 'error';
      $user.focus();
      return false;
    }

    if ($pass.value == "") {
      $pass.className = 'error';
      $pass.focus();
      return false;
    }

    var $btn = document.getElementById('btn-login');
    $btn.disabled = true;
    $btn.textContent = 'Logging in...';
    return true;
  }
  </script>
</div>
