<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Nebula" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nebula">
    <meta name="mobile-web-app-capable" content="yes">
    <meta property="og:site_name" content="Nebula">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <div id="overlay"></div>

    <header>
      <h2><a href="/">Nebula</a></h2>
      <nav class="tabs">
        <a href="/"<%= ' class="selected"'.html_safe if request.path == "/" || request.path.start_with?("/read") %>>Home</a>
        <% if logged_in? %>
          <a href="/me/c"<%= ' class="selected"'.html_safe if request.path.start_with?("/me/c") %>>Blogs</a>
          <a href="/me/posts"<%= ' class="selected"'.html_safe if request.path == "/me/posts" %>>Drafts</a>
        <% else %>
          <a href="/signup"<%= ' class="selected"'.html_safe if request.path == "/signup" %>>Sign up</a>
          <a href="/login"<%= ' class="selected"'.html_safe if request.path == "/login" %>>Log in</a>
        <% end %>
      </nav>
      <% if logged_in? %>
        <nav id="user-nav">
          <ul>
            <li class="has-submenu">
              <a><%= current_user.username %> <span style="font-size: 0.7em; color: #999; text-transform: uppercase;">&#9660;</span></a>
              <ul>
                <% if current_user.is_admin? %>
                  <li><a href="/admin">Admin dashboard</a></li>
                <% end %>
                <li><a href="/me">Account settings</a></li>
                <li class="separator"><hr></li>
                <li><a href="/logout">Log out</a></li>
              </ul>
            </li>
          </ul>
        </nav>
        <div class="right-side" style="float: right;">
          <a class="simple-btn primary" href="/new">New Post</a>
        </div>
      <% end %>
    </header>

    <div id="official-writing">
      <%= render "shared/flash" %>
      <%= yield %>
    </div>

    <%= render "shared/footer" %>
  </body>
</html>
