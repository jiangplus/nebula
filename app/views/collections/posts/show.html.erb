<% content_for(:title) do %>
  <%= @post.title.present? ? @post.title : @post.created_at.strftime("%B %-d, %Y") %> — <%= @collection.title.present? ? @collection.title : @collection.alias %>
<% end %>

<% content_for(:head) do %>
<link rel="canonical" href="/<%= @collection.alias %>/<%= @post.slug %>">
<meta name="generator" content="Nebula">
<meta name="title" content="<%= @post.title %>">
<meta name="description" content="<%= truncate(@post.content || '', length: 160) %>">
<meta name="author" content="<%= @collection.title %>">
<meta itemprop="description" content="<%= truncate(@post.content || '', length: 160) %>">
<meta itemprop="datePublished" content="<%= @post.created_at.iso8601 %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= @post.title %> — <%= @collection.title.present? ? @collection.title : @collection.alias %>">
<meta name="twitter:description" content="<%= truncate(@post.content || '', length: 160) %>">
<meta property="og:title" content="<%= @post.title %>">
<meta property="og:description" content="<%= truncate(@post.content || '', length: 160) %>">
<meta property="og:site_name" content="<%= @collection.title.present? ? @collection.title : @collection.alias %>">
<meta property="og:type" content="article">
<meta property="og:url" content="/<%= @collection.alias %>/<%= @post.slug %>">
<meta property="article:published_time" content="<%= @post.created_at.iso8601 %>">
<% if @collection.style_sheet.present? %>
<style type="text/css"><%= @collection.style_sheet %></style>
<% end %>
<% end %>

<div id="post">
  <div id="overlay"></div>

  <header>
    <h1 id="blog-title">
      <a rel="author" href="/<%= @collection.alias %>/" class="h-card p-author">
        <%= @collection.title.present? ? @collection.title : @collection.alias %>
      </a>
    </h1>
    <nav>
      <% if logged_in? && can_edit_post?(@post) %>
        <span class="views" dir="ltr"><strong><%= @post.view_count %></strong> <%= "view".pluralize(@post.view_count) %></span>
        <a href="/<%= @collection.alias %>/<%= @post.slug %>/edit">Edit</a>
      <% end %>
    </nav>
  </header>

  <article id="post-body" class="h-entry">
    <% if @post.title.present? %>
      <h2 id="title" class="p-name dated"><%= @post.title %></h2>
    <% end %>
    <time class="dt-published" datetime="<%= @post.created_at.iso8601 %>" pubdate itemprop="datePublished">
      <%= @post.created_at.strftime("%B %-d, %Y") %>
    </time>
    <div class="e-content">
      <%= simple_format(@post.content) %>
    </div>
  </article>

  <% if @post.collection&.post_signature.present? %>
    <div class="post-signature">
      <%= simple_format(@post.collection.post_signature) %>
    </div>
  <% end %>

  <footer>
    <hr>
    <nav dir="ltr">
      <p style="font-size: 0.9em">Published with <a href="/">Nebula</a>.</p>
    </nav>
  </footer>
</div>
